# ---------------------------------------------------------------
# ZENTRO BuildMart environment template.
# Copy to .env.local for local development. Never commit real values.
# Set the same names in Vercel: Project Settings > Environment Variables.
# ---------------------------------------------------------------

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Used by webhooks, cron and guest routes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed site. Used for QR codes and payment callbacks.
# REQUIRED in Production (the app refuses to start links with localhost there).
# Local development: http://localhost:3000   Production example: https://buildmart.zentro.example  (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay (Dashboard > Account & Settings > API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-side REST client uses the same key id. Set it to the same value as NEXT_PUBLIC_RAZORPAY_KEY_ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Account & Settings > Webhooks > secret for the webhook URL below
RAZORPAY_WEBHOOK_SECRET=
# Webhook URL to register: {NEXT_PUBLIC_APP_URL}/api/webhooks/razorpay

# Scheduled jobs. Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Payment mode: "razorpay" in every real environment.
# "simulator" is a development-only fake payment; it is refused when NODE_ENV or VERCEL_ENV is production.
# Do not set it to simulator in Vercel Production.
ZENTRO_PAYMENT_MODE=razorpay

# AI Room Visualizer Provider (Server-side only. Never expose as NEXT_PUBLIC_*)
# Use "disabled" in production unless HF_TOKEN or OPENAI_API_KEY is configured.
# Use "comfyui" for local development only (never in Vercel Production).
AI_IMAGE_PROVIDER=disabled
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
COMFYUI_UNET=sd15-unet-fp16.safetensors
COMFYUI_CLIP=clip_l.safetensors
COMFYUI_VAE=vae-ft-mse-840000-ema-pruned.safetensors

# Hugging Face AI Room Visualizer (Optional)
HF_TOKEN=
HF_IMAGE_MODEL=Qwen/Qwen-Image-Edit-2509
HF_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# OpenAI AI Room Visualizer (Fallback / Optional)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
OPENAI_IMAGE_PREVIEW_MODEL=gpt-image-2.6-flare
OPENAI_VISION_MODEL=gpt-4o-mini


