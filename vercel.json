{
  "framework": "nextjs",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/expire-payments",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/storage-orphans",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/expire-quotations",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}